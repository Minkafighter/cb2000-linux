[Unit]
Description=CanvasBio CB2000 Fingerprint Authentication Daemon (Rust SDCP)
Documentation=https://github.com/Minkafighter/cb2000-linux
After=dbus.service polkit.service
Conflicts=fprintd.service

[Service]
Type=dbus
BusName=net.reactivated.Fprint
ExecStart=/usr/local/bin/cb2000-fprintd --state-dir /var/lib/cb2000-fprintd
Restart=on-failure
RestartSec=2s

# Persistent root-owned enrollment binding store (0700)
StateDirectory=cb2000-fprintd
StateDirectoryMode=0700

# Systemd Security Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# Restrict device access strictly to USB character devices (/dev/bus/usb/*)
DevicePolicy=closed
DeviceAllow=char-usb_device rwm

[Install]
WantedBy=multi-user.target
Alias=dbus-net.reactivated.Fprint.service
